$(info "lib-gd32/Makefile.GD32")
$(info $$FAMILY [${FAMILY}])
$(info $$MAKE_FLAGS [${MAKE_FLAGS}])

DEFINES=NDEBUG

EXTRA_SRCDIR =src/f

ifneq ($(MAKE_FLAGS),)
  	EXTRA_SRCDIR+=gd32f4xx/CMSIS/GD/GD32F4xx/Source
  	
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_adc.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_dma.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_enet.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_exti.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_fmc.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_fwdgt.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_gpio.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_i2c.c
   	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_misc.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_pmu.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_rcu.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_rtc.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_spi.c
   	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_syscfg.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_usart.c
  	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_standard_peripheral/Source/gd32f4xx_timer.c
  	
	ifeq ($(findstring NO_EMAC,$(MAKE_FLAGS)), NO_EMAC)
	else
		EXTRA_SRCDIR+=device/enet/f
  	endif
   	
   	EXTRA_SRCDIR+=device/usb
   	
  	ifeq ($(findstring ENABLE_USB_HOST,$(MAKE_FLAGS)), ENABLE_USB_HOST)
    	EXTRA_SRCDIR+=device/usb/f device/usb/f/host
    	EXTRA_SRCDIR+=gd32f4xx/GD32F4xx_usb_library/host/core/Source
    	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usb_core.c
    	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usb_host.c
    	EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usbh_int.c
      		
		ifeq ($(findstring CONFIG_USB_HOST_MSC,$(MAKE_FLAGS)), CONFIG_USB_HOST_MSC)
  			EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/host/class/msc/Source/usbh_msc_bbb.c
  			EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/host/class/msc/Source/usbh_msc_core.c
  	  		EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/host/class/msc/Source/usbh_msc_scsi.c
  			EXTRA_SRCDIR+=device/usb/host/msc
  		endif
  	endif
  	
	ifeq ($(findstring ENABLE_USB_DEVICE,$(MAKE_FLAGS)), ENABLE_USB_DEVICE)
 		EXTRA_SRCDIR+=gd32f4xx/GD32F4xx_usb_library/device/core/Source
 	    EXTRA_C_SOURCE_FILES=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usb_core.c
 	    EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usb_dev.c
 	    EXTRA_C_SOURCE_FILES+=gd32f4xx/GD32F4xx_usb_library/driver/Source/drv_usbd_int.c
  	 endif
endif

include Rules.mk
include ../firmware-template-gd32/lib/Rules.mk